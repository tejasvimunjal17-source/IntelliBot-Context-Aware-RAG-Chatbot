# ============================================================
# IntelliBot configuration template
# 1) Copy this file to a new file named  .env
# 2) Put your own keys in .env   (the .env file is NEVER uploaded)
# 3) On Streamlit Cloud, put these in  App > Settings > Secrets  instead
# ============================================================

# --- LLM that writes the answers (Day 4) ---
# Which service to use: "openai" or "huggingface".
# An API key is needed ONLY for answer generation. Uploading, chunking, embeddings,
# indexing and search work without any key.
LLM_PROVIDER=openai

# --- OpenAI (used if LLM_PROVIDER=openai). Get a key at platform.openai.com ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Hugging Face (used if LLM_PROVIDER=huggingface). Token: huggingface.co/settings/tokens ---
# Uses Hugging Face's OpenAI-compatible endpoint. Pick a chat model that your account can use.
HUGGINGFACEHUB_API_TOKEN=your-huggingface-token-here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Hugging Face's OpenAI-compatible endpoint (change only if Hugging Face changes it).
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Conversation memory: how many question+answer exchanges one chat keeps (0 = off, max 20).
# History lives only in memory for the current browser session; it is never saved to disk.
CHAT_HISTORY_TURNS=4

# Answer length limit (50-4000 tokens) and how long to wait for the LLM (5-300 seconds).
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=30

# --- Embeddings (Day 2). Local model, no API key needed ---
# The first run downloads the model (about 90 MB) from Hugging Face.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking (Day 2). Measured in characters ---
# CHUNK_SIZE must be 100-4000. CHUNK_OVERLAP must be 0 up to half of CHUNK_SIZE.
# Invalid values are ignored and the defaults below are used.
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# --- Vector store and retrieval (Day 3) ---
# Where the search index is saved (relative to the project folder, or a full path).
VECTOR_STORE_DIR=chroma_db
# How many chunks a search returns (1-50) and the lowest similarity (0-1) counted as relevant.
TOP_K=4
MIN_SIMILARITY=0.2

# --- Upload limits (used from Day 1) ---
# NOTE: Streamlit has its own upload cap in .streamlit/config.toml (maxUploadSize, also 10 MB).
# If you raise MAX_UPLOAD_MB, raise maxUploadSize there too, or uploads above 10 MB are refused.
MAX_UPLOAD_MB=10
